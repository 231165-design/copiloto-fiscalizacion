# Copia este archivo a .env y completa los valores.
# Las variables VITE_* son las únicas que Vite expone al navegador.

# ── Modo demo (Vercel sin backend) ────────────────────────────────────────────
# Deja VITE_API_BASE_URL vacía O pon VITE_DEMO_MODE=true para activar
# los datos simulados en el frontend. No se hace ninguna petición de red.
#
# VITE_API_BASE_URL=
# VITE_API_KEY=
# VITE_DEMO_MODE=true

# ── Mock local (desarrollo con mock-api.js) ───────────────────────────────────
# VITE_API_BASE_URL=http://localhost:3001
# VITE_API_KEY=mock-key

# ── AWS real (producción / hackatón con backend desplegado) ───────────────────
VITE_API_BASE_URL=https://<id>.execute-api.<region>.amazonaws.com/prod
VITE_API_KEY=<tu-api-key>
# VITE_DEMO_MODE=false
